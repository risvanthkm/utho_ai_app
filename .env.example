# =============================================================================
# SmartCloud Optimizer (FinSort) — Unified Docker Compose Environment Config
# Copy to .env if you want to customize ports, paths, or optional LLM API keys.
# =============================================================================

# Host Ports
FRONTEND_PORT=5173
BACKEND_PORT=8080
AI_PORT=8001
DB_PORT=5432

# TimescaleDB / PostgreSQL Credentials
POSTGRES_DB=resource_advisor
POSTGRES_USER=resource_advisor
POSTGRES_PASSWORD=change-this-local-password

# Sibling Repository Paths
BACKEND_PATH=../utho_backend
FRONTEND_PATH=../utho_frontend
AI_APP_PATH=.

# Frontend API Base URL (keep as /api/v1 so Nginx reverse-proxies seamlessly on any host/IP)
VITE_API_BASE_URL=/api/v1

# Optional Gemini / TypeSafe API Keys for Python AI Service (:8001)
# (If left blank, Python AI automatically uses its deterministic statistical/SRE engine)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# GreenOps Datacenter & India CEA Grid Constants
DATA_CENTER_PUE=1.4
GRID_CARBON_KG_PER_KWH=0.71
WATTS_PER_VCPU_IDLE=5
WATTS_PER_VCPU_FULL=15
